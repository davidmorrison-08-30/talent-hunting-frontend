# Base URL of the API the browser talks to.
#
# In production this is the BFF (Lambda behind API Gateway) URL and is
# injected at build time by the CI pipeline.
#
# Leave it empty for local development: the Vite dev server then proxies
# /api, /auth and /health to the backend at VITE_DEV_BACKEND_URL.
VITE_API_BASE_URL=

# Local backend used by the Vite dev-server proxy (development only).
VITE_DEV_BACKEND_URL=http://localhost:8000
